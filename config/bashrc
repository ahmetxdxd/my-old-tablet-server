# My Tablet Server - Bash Environment
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TERM=xterm-256color
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

# Colored Prompt
export PS1='\[\033[01;32m\]root@my-tablet-server\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# '

# Aliases
alias ll='ls -la --color=auto'
alias ls='ls --color=auto'
alias status='server-status'
alias console='tmux attach -t console || tmux new -s console'
alias play='play-sound'
alias volume='set-volume'
alias screen='screen-ctrl'

# Display MOTD on interactive login
if [ -f /etc/motd ] && [ -t 1 ]; then
    cat /etc/motd
fi
