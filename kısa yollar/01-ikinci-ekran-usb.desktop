[Desktop Entry]
Version=1.0
Type=Application
Name=İkinci Ekran Başlat (USB)
Comment=Tableti USB kablosuyla sıfır gecikmeli PC ikinci ekranı yapar
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "second-screen-usb" "İkinci Ekran (USB)" "Tablet USB ikinci ekran olarak başlatılıyor..."'
Icon=video-display
Terminal=false
Categories=Utility;System;
StartupNotify=true
