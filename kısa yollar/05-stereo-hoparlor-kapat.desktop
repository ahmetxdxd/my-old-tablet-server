[Desktop Entry]
Version=1.0
Type=Application
Name=Stereo Hoparlörleri Kapat
Comment=Tablet hoparlör ses akışını durdurur
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "stereo-speakers-stop" "Stereo Hoparlörler Durduruldu" "Ses akışı sonlandırıldı."'
Icon=audio-volume-muted
Terminal=false
Categories=Utility;System;
StartupNotify=true
