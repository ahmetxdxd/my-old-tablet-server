[Desktop Entry]
Version=1.0
Type=Application
Name=Ekran Koruyucu - Akvaryum
Comment=Tablette tropikal mercan resifi canlı akvaryumunu başlatır
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "screensaver aquarium" "Ekran Koruyucu" "Canlı akvaryum modu başlatıldı."'
Icon=preferences-desktop-screensaver
Terminal=false
Categories=Utility;System;
StartupNotify=true
