[Desktop Entry]
Version=1.0
Type=Application
Name=Ekran Koruyucu - Frutiger Aero
Comment=Tablette Frutiger Aero estetik görsel döngüsünü başlatır
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "screensaver art" "Ekran Koruyucu" "Frutiger Aero döngüsü başlatıldı."'
Icon=preferences-desktop-screensaver
Terminal=false
Categories=Utility;System;
StartupNotify=true
