[Desktop Entry]
Version=1.0
Type=Application
Name=Canlı Tablet Terminali (SSH)
Comment=SSH yazmadan tabletin canlı Linux konsoluna bağlanır
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "tablet-terminal" "Tablet Terminali" "Canlı terminale bağlanılıyor..."'
Icon=utilities-terminal
Terminal=true
Categories=Utility;System;
StartupNotify=true
