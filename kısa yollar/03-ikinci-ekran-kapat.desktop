[Desktop Entry]
Version=1.0
Type=Application
Name=İkinci Ekranı Kapat
Comment=İkinci ekranı kapatır ve tableti normal arayüze döndürür
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "second-screen-stop" "İkinci Ekran Kapatıldı" "İkinci ekran oturumu kapatıldı."'
Icon=process-stop
Terminal=false
Categories=Utility;System;
StartupNotify=true
