#!/bin/bash
# ==============================================================================
# My Tablet Server - Quick Terminal Launcher (No SSH Confusion)
# ==============================================================================
# Connects directly to the tablet's live Linux console with a single command.
# Automatically detects USB cable (ADB port forward) or Wi-Fi LAN IP.
# Seamlessly falls back to direct ADB chroot if SSH is temporarily unavailable.
# ==============================================================================

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
GREEN='\033[01;32m'
BLUE='\033[01;34m'
YELLOW='\033[01;33m'
RED='\033[01;31m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BLUE}${BOLD}======================================================${NC}"
echo -e "${BLUE}${BOLD}       📱 MY TABLET SERVER - QUICK TERMINAL           ${NC}"
echo -e "${BLUE}${BOLD}======================================================${NC}"

# Check for manual IP argument
TARGET_IP="$1"

# 1. Check if tablet is connected via USB (ADB)
ADB_DEVICE=$(adb devices 2>/dev/null | grep -E "\bdevice$" | awk '{print $1}' | head -n1 || true)

if [ -n "$ADB_DEVICE" ]; then
    echo -e "${GREEN}✓ Tablet detected via USB (${ADB_DEVICE})${NC}"
    adb forward tcp:2222 tcp:22 2>/dev/null || true

    # Try quick SSH check over forwarded port 2222
    if ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=2 -p 2222 -q root@127.0.0.1 "exit" 2>/dev/null; then
        echo -e "${BLUE}--> Connecting to live console (USB SSH :2222)...${NC}\n"
        exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p 2222 -t root@127.0.0.1 "console 2>/dev/null || tmux attach -t console 2>/dev/null || /bin/bash 2>/dev/null || /bin/sh"
    else
        # If SSH key / daemon is not ready, use direct ADB chroot console fallback
        echo -e "${YELLOW}--> Connecting via direct ADB chroot console fallback...${NC}\n"
        exec adb -s "$ADB_DEVICE" shell "su -c '
            L=/data/local/linux/lib/ld-musl-armhf.so.1
            B=/data/local/linux/bin/busybox
            R=/data/local/linux
            if [ -f \$R/enter.sh ]; then
                sh \$R/enter.sh
            elif [ -f \$R/bin/bash ]; then
                \$L \$B chroot \$R /bin/bash
            else
                \$L \$B chroot \$R /bin/sh
            fi
        '"
    fi
fi

# 2. If USB is not connected, search for Wi-Fi IP
if [ -z "$TARGET_IP" ]; then
    # Check ~/.ssh/config for recorded tablet IP
    if [ -f "$HOME/.ssh/config" ]; then
        TARGET_IP=$(awk '/Host my-tablet-server/{flag=1; next} /Host /{flag=0} flag && /HostName/{print $2; exit}' "$HOME/.ssh/config" 2>/dev/null || true)
    fi
fi

if [ -n "$TARGET_IP" ]; then
    echo -e "${GREEN}✓ Tablet Wi-Fi IP detected: ${TARGET_IP}${NC}"
    echo -e "${BLUE}--> Connecting to live console (Wi-Fi SSH)...${NC}\n"
    exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -t "root@${TARGET_IP}" "console 2>/dev/null || tmux attach -t console 2>/dev/null || /bin/bash 2>/dev/null || /bin/sh"
fi

# 3. No connection found
echo -e "${RED}[WARNING] Tablet connection not found!${NC}"
echo -e "Please ensure one of the following:"
echo -e "  1. ${YELLOW}USB Cable:${NC} Connect tablet via USB (ensure USB Debugging is enabled)."
echo -e "  2. ${YELLOW}Wi-Fi Network:${NC} Connect tablet to the same Wi-Fi network as this PC."
echo -e "  3. ${YELLOW}Manual IP:${NC} Run 'tablet-terminal <TABLET_IP>' with your tablet's IP address."
echo -e "${BLUE}======================================================${NC}"
exit 1
