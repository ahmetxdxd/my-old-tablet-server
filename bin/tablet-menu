#!/bin/bash
# ==============================================================================
# My Tablet Server - Interactive Terminal Quick Menu
# ==============================================================================
# Allows running all README commands without entering the tablet terminal.
# ==============================================================================

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
GREEN='\033[01;32m'
BLUE='\033[01;34m'
YELLOW='\033[01;33m'
CYAN='\033[01;36m'
RED='\033[01;31m'
BOLD='\033[1m'
NC='\033[0m'

pause() {
    echo ""
    read -rp "Press [Enter] to return to the menu..."
}

run_cmd() {
    echo -e "\n${BLUE}--> Executing command: ${YELLOW}$*${NC}\n"
    "$DIR/tablet" run "$@"
    pause
}

while true; do
    clear
    echo -e "${CYAN}${BOLD}"
    cat << 'BANNER'
  __  __         _______     _     _      _      _____                          
 |  \/  |       |__   __|   | |   | |    | |    / ____|                         
 | \  / |_   _     | | __ _ | |__ | | ___| |_  | (___   ___ _ ____   _____ _ __ 
 | |\/| | | | |    | |/ _` || '_ \| |/ _ \ __|  \___ \ / _ \ '__\ \ / / _ \ '__|
 | |  | | |_| |    | | (_| || |_) | |  __/ |_   ____) |  __/ |   \ V /  __/ |   
 |_|  |_|\__, |    |_|\__,_||_.__/|_|\___|\__| |_____/ \___|_|    \_/ \___|_|   
          __/ |                                                                 
         |___/      📱 QUICK CONTROL PANEL & SHORTCUT DASHBOARD                 
BANNER
    echo -e "${NC}"
    echo -e "${YELLOW}Manage and trigger all tablet features with a single key without entering the tablet:${NC}\n"

    echo -e "  ${BOLD}[ 📊 SYSTEM & STATUS ]${NC}"
    echo -e "   ${GREEN}1${NC}) Tablet System Status Report   ${CYAN}(CPU temp, RAM, battery %, IP)${NC}"
    echo -e "   ${GREEN}2${NC}) Live Tablet Terminal (SSH)    ${CYAN}(Jump into terminal with zero hassle)${NC}"
    echo -e ""
    echo -e "  ${BOLD}[ 🖥️ PC SECOND MONITOR (SECOND SCREEN) ]${NC}"
    echo -e "   ${GREEN}3${NC}) Start Second Screen - USB     ${CYAN}(Zero latency wired cable mode)${NC}"
    echo -e "   ${GREEN}4${NC}) Start Second Screen - Wi-Fi   ${CYAN}(Wireless local network mode)${NC}"
    echo -e "   ${GREEN}5${NC}) Stop Second Screen            ${CYAN}(Detach monitor & restore tablet)${NC}"
    echo -e ""
    echo -e "  ${BOLD}[ 📻 STEREO SPEAKERS & CAVA ]${NC}"
    echo -e "   ${GREEN}6${NC}) Start PC Stereo Speakers      ${CYAN}(Stream PC audio to tablet speakers)${NC}"
    echo -e "   ${GREEN}7${NC}) Open CAVA Spectrum Visualizer ${CYAN}(Live audio frequency visualizer)${NC}"
    echo -e "   ${GREEN}8${NC}) Stop Stereo Speakers          ${CYAN}(Terminate audio streaming)${NC}"
    echo -e ""
    echo -e "  ${BOLD}[ 🌸 SCREENSAVERS & AMBIENT DISPLAY ]${NC}"
    echo -e "   ${GREEN}9${NC}) Frutiger Aero Art Slideshow   ${CYAN}(Nostalgic nature & glossy artwork)${NC}"
    echo -e "  ${GREEN}10${NC}) Tropical Coral Aquarium Loop  ${CYAN}(Live underwater reef loop)${NC}"
    echo -e "  ${GREEN}11${NC}) Cozy Glowing Fireplace Loop   ${CYAN}(Relaxing burning log fire)${NC}"
    echo -e "  ${GREEN}12${NC}) Cyber Matrix Digital Rain     ${CYAN}(Classic green code rain)${NC}"
    echo -e "  ${GREEN}13${NC}) Stop Screensaver              ${CYAN}(Return to home screen)${NC}"
    echo -e ""
    echo -e "  ${BOLD}[ 🎌 MEDIA & INTERNET RADIO ]${NC}"
    echo -e "  ${GREEN}14${NC}) Launch AnimeDLR App           ${CYAN}(Ad-free streaming anime player)${NC}"
    echo -e "  ${GREEN}15${NC}) Lofi Hip Hop Radio Stream     ${CYAN}(24/7 chill beats)${NC}"
    echo -e "  ${GREEN}16${NC}) Smooth Jazz Radio Stream      ${CYAN}(Relaxing cafe jazz)${NC}"
    echo -e ""
    echo -e "  ${BOLD}[ ⚡ OPERATING MODES & POWER ]${NC}"
    echo -e "  ${GREEN}17${NC}) Pure Linux Server Mode        ${CYAN}(Screen OFF, Maximum free RAM)${NC}"
    echo -e "  ${GREEN}18${NC}) Pure Android Tablet Mode      ${CYAN}(Normal tablet GUI & launcher)${NC}"
    echo -e "  ${GREEN}19${NC}) Hybrid Dual Mode              ${CYAN}(Android UI + Background Linux daemons)${NC}"
    echo -e "  ${GREEN}20${NC}) Safe Tablet Debloater         ${CYAN}(Freeze 60+ bloatware packages safely)${NC}"
    echo -e "  ${GREEN}21${NC}) Turn Screen Light ON / OFF    ${CYAN}(ON: screen on, OFF: screen off)${NC}"
    echo -e "  ${GREEN}22${NC}) Set Speaker Hardware Volume   ${CYAN}(Range: 0 - 100)${NC}"
    echo -e ""
    echo -e "  ${BOLD}[ ⌨️ CUSTOM COMMAND EXECUTION ]${NC}"
    echo -e "  ${GREEN}23${NC}) Execute Custom Tablet Command ${CYAN}(watch, yt, alarm, play-sound...)${NC}"
    echo -e ""
    echo -e "   ${RED}0${NC}) Exit"
    echo -e "${CYAN}----------------------------------------------------------------------${NC}"
    read -rp "Please enter an option [0-23]: " CHOICE

    case "$CHOICE" in
        1)
            run_cmd "my-tablet-server status"
            ;;
        2)
            clear
            exec "$DIR/tablet-terminal"
            ;;
        3)
            clear
            echo -e "${YELLOW}Monitor position: [right (default), left, above, below]${NC}"
            read -rp "Position (press enter for 'right'): " POS
            POS="${POS:-right}"
            "$DIR/second-screen" usb "$POS" || run_cmd "second-screen usb $POS"
            pause
            ;;
        4)
            clear
            echo -e "${YELLOW}Monitor position: [right (default), left, above, below]${NC}"
            read -rp "Position (press enter for 'right'): " POS
            POS="${POS:-right}"
            "$DIR/second-screen" wifi "$POS" || run_cmd "second-screen wifi $POS"
            pause
            ;;
        5)
            "$DIR/second-screen" stop 2>/dev/null || true
            run_cmd "second-screen stop"
            ;;
        6)
            "$DIR/stereo-speakers" start || run_cmd "stereo-speakers start"
            pause
            ;;
        7)
            "$DIR/stereo-speakers" cava || run_cmd "stereo-speakers cava"
            pause
            ;;
        8)
            "$DIR/stereo-speakers" stop 2>/dev/null || true
            run_cmd "stereo-speakers stop"
            ;;
        9)
            run_cmd "screensaver art"
            ;;
        10)
            run_cmd "screensaver aquarium"
            ;;
        11)
            run_cmd "screensaver fireplace"
            ;;
        12)
            run_cmd "screensaver matrix"
            ;;
        13)
            run_cmd "screensaver stop"
            ;;
        14)
            run_cmd "anime app"
            ;;
        15)
            run_cmd "radio lofi"
            ;;
        16)
            run_cmd "radio jazz"
            ;;
        17)
            run_cmd "my-tablet-server linux"
            ;;
        18)
            run_cmd "my-tablet-server android"
            ;;
        19)
            run_cmd "my-tablet-server hybrid"
            ;;
        20)
            run_cmd "debloat-tablet"
            ;;
        21)
            echo -e "Screen Backlight: [1] Turn ON (screen on), [2] Turn OFF (screen off)"
            read -rp "Selection [1/2]: " SCR_CHOICE
            if [ "$SCR_CHOICE" = "1" ]; then
                run_cmd "screen on"
            else
                run_cmd "screen off"
            fi
            ;;
        22)
            read -rp "Enter volume level (0 - 100): " VOL
            if [ -n "$VOL" ]; then
                run_cmd "set-volume $VOL"
            fi
            ;;
        23)
            echo -e "${YELLOW}Enter the command to run on the tablet:${NC}"
            echo -e "Examples: ${CYAN}watch https://stream.mp4${NC}  or  ${CYAN}yt 'Song Name'${NC}  or  ${CYAN}alarm play${NC}"
            read -rp "Command: " CUSTOM_CMD
            if [ -n "$CUSTOM_CMD" ]; then
                run_cmd "$CUSTOM_CMD"
            fi
            ;;
        0|q|exit)
            echo -e "\n${GREEN}Goodbye!${NC}"
            exit 0
            ;;
        *)
            echo -e "\n${RED}Invalid option! Please try again.${NC}"
            sleep 1
            ;;
    esac
done
