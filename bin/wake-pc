#!/bin/bash
# ==============================================================================
# My Tablet Server - Wake Host PC (Wake-on-LAN)
# ==============================================================================

PC_MAC="${1:-$PC_MAC}"
BROADCAST="${2:-255.255.255.255}"

if [ -z "$PC_MAC" ]; then
    echo "Usage: wake-pc <PC_MAC_ADDRESS> [BROADCAST_IP]"
    echo "Example: wake-pc 00:11:22:33:44:55"
    exit 1
fi

echo "[Wake-on-LAN] Sending magic packet -> MAC: $PC_MAC (Broadcast: $BROADCAST)..."
which etherwake >/dev/null 2>&1 && etherwake -b "$PC_MAC" || \
which wakeonlan >/dev/null 2>&1 && wakeonlan -i "$BROADCAST" "$PC_MAC" || \
echo "[Wake-on-LAN] Error: Neither 'wakeonlan' nor 'etherwake' found."
echo "[Wake-on-LAN] Magic packet sent."
