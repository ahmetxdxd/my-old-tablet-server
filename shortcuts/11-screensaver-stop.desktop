[Desktop Entry]
Version=1.0
Type=Application
Name=Stop Screensaver
Comment=Stop screensaver and return to home screen
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "screensaver stop" "Screensaver" "Screensaver stopped."'
Icon=media-playback-stop
Terminal=false
Categories=Utility;System;
StartupNotify=true
