[Desktop Entry]
Version=1.0
Type=Application
Name=Second Screen - Wi-Fi
Comment=Turn tablet into wireless PC second monitor via home Wi-Fi
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "second-screen-wifi" "Second Screen (Wi-Fi)" "Starting second screen over Wi-Fi..."'
Icon=network-wireless
Terminal=false
Categories=Utility;System;
StartupNotify=true
