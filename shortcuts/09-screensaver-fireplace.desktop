[Desktop Entry]
Version=1.0
Type=Application
Name=Screensaver - Fireplace
Comment=Start cozy burning fireplace video loop
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "screensaver fireplace" "Screensaver" "Cozy fireplace started."'
Icon=preferences-desktop-screensaver
Terminal=false
Categories=Utility;System;
StartupNotify=true
