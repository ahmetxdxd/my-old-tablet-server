[Desktop Entry]
Version=1.0
Type=Application
Name=Stop Stereo Speakers
Comment=Stop tablet audio streaming
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "stereo-speakers-stop" "Stereo Speakers Stopped" "Speaker audio stream terminated."'
Icon=audio-volume-muted
Terminal=false
Categories=Utility;System;
StartupNotify=true
