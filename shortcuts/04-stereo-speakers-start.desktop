[Desktop Entry]
Version=1.0
Type=Application
Name=Start Stereo Speakers
Comment=Stream PC audio split (Left/Right) to tablet stereo speakers
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "stereo-speakers-start" "Stereo Speakers" "Streaming PC audio to tablet speakers..."'
Icon=audio-speakers
Terminal=false
Categories=Utility;System;
StartupNotify=true
