[Desktop Entry]
Version=1.0
Type=Application
Name=Second Screen - USB
Comment=Turn tablet into zero-latency PC second monitor via USB cable
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "second-screen-usb" "Second Screen (USB)" "Starting second screen over USB..."'
Icon=video-display
Terminal=false
Categories=Utility;System;
StartupNotify=true
