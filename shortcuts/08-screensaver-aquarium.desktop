[Desktop Entry]
Version=1.0
Type=Application
Name=Screensaver - Coral Aquarium
Comment=Start tropical coral reef live aquarium video loop
Exec=bash -c '"$(dirname "%k")/.run_silent.sh" "screensaver aquarium" "Screensaver" "Coral reef aquarium started."'
Icon=preferences-desktop-screensaver
Terminal=false
Categories=Utility;System;
StartupNotify=true
