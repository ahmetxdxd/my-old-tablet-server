[Desktop Entry]
Version=1.0
Type=Application
Name=My Tablet Server - Control Center
GenericName=Tablet Control Center
Comment=Modern Graphical Multi-Tablet Dashboard & Control Center
Exec=sh -c '"$(dirname "$1")/../../dashboard.sh"' dummy %k
